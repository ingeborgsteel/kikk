# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# GitHub API Configuration
# Personal access token for creating issues
VITE_GITHUB_TOKEN=your_github_token_here

# Cloudflare Logging
# Set to "true" to enable logging to Cloudflare Workers (production only)
VITE_ENABLE_CLOUDFLARE_LOGGING=false

# Login gate
# Production builds require login by default. Uncomment and set
# VITE_FORCE_LOGIN="false" or VITE_ALLOW_GUEST_BYPASS="true" to enable the
# hidden guest bypass for local previews or feature branch deployments.
# VITE_FORCE_LOGIN=false
# VITE_ALLOW_GUEST_BYPASS=false