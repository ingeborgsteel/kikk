# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# GitHub API Configuration
# Personal access token for creating issues
VITE_GITHUB_TOKEN=your_github_token_here

# Email Export Configuration (optional)
# Resend API key for sending export emails - get from https://resend.com
VITE_RESEND_API_KEY=your_resend_api_key_here

# Worker URL for email export API (defaults to current origin if not set)
VITE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Default "from" email address for exports
VITE_EXPORT_EMAIL_FROM=kikk@yourdomain.com